# LinkCtrl configuration.
#
# Copy to .env and fill in the three required secrets. Everything else has a
# working default.
#
#   cp .env.example .env
#   openssl rand -base64 48    # once per secret below
#
# Validation is aggregated: if several values are wrong, starting the server
# reports all of them at once. `lctl config check` runs the same validation
# without starting anything.
#
# IMPORTANT on Windows: save this file with LF line endings. A CRLF here makes
# POSTGRES_PASSWORD end in an invisible carriage return, and Postgres then
# initializes with a password nobody can type. .gitattributes enforces LF for
# the committed copy.

# ─── Required ────────────────────────────────────────────────────────────────
# Canonical origin. Used to build short URLs, to check the Origin header for
# CSRF, and to scope cookies. No trailing path, query or fragment.
# Must be https in production: session cookies use the __Host- prefix, which
# browsers only accept over TLS. http://localhost is fine for local use.
LINKCTRL_BASE_URL=http://localhost:8080

# At least 32 bytes. Rotating this invalidates every existing API key.
LINKCTRL_API_KEY_PEPPER=
POSTGRES_PASSWORD=

# Two-factor authentication (M53). Optional: unset means no second factor is
# offered, which is what every instance was before it existed. At least 32 bytes.
# It encrypts the TOTP secret at rest, so losing it locks every enrolled account
# out of the second factor — they sign in with a recovery code, turn the factor
# off with another, and enrol again. Deliberately NOT the API key pepper: those
# are two credential lifecycles and rotating one must not end the other.
#   openssl rand -base64 48
LINKCTRL_MFA_SECRET_KEY=

# Any of these may instead be supplied from a file, for Docker/Swarm secrets:
#   LINKCTRL_API_KEY_PEPPER_FILE=/run/secrets/api_key_pepper
# Setting both the inline and _FILE form for the same secret is an error.
# Supported: API_KEY_PEPPER, MFA_SECRET_KEY, DATABASE_URL, SMTP_PASSWORD,
# FEED_AUTH_TOKEN.

# ─── Core ────────────────────────────────────────────────────────────────────
LINKCTRL_APP_ENV=development          # development | production
# Optional: serve the dashboard and short links on separate hostnames. Both
# default to BASE_URL, and leaving them unset is the single-host deployment
# unchanged. Set to different hosts and each answers only its own paths, which
# puts the session cookie out of reach of the host serving short links.
# Both names must resolve to this listener; there is still only one.
#LINKCTRL_APP_BASE_URL=https://manage.example.com
#LINKCTRL_LINK_BASE_URL=https://lnk.example.com
LINKCTRL_HTTP_ADDR=:8080
LINKCTRL_HTTP_PORT=8080               # host port published by compose
# A second listener serving GET /metrics for Prometheus, and nothing else. It
# is deliberately separate from the public one: the series include queue depths,
# connection-pool saturation and traffic shape, which is operational detail
# rather than something to publish. There is no authentication on it, so do not
# expose the port — compose does not publish it, and a reverse proxy should not
# forward it.
LINKCTRL_METRICS_ADDR=:9090           # internal only; not published by compose
LINKCTRL_LOG_LEVEL=info               # debug | info | warn | error
LINKCTRL_LOG_FORMAT=json              # json | text
LINKCTRL_DOCS_ENABLED=true
# Publishes the server's own view of how long a response took, on the application
# tree only. Off by default because it is a timing side channel, not because it is
# expensive.
LINKCTRL_SERVER_TIMING=false

# Set to false only for local HTTP development; refused when APP_ENV=production.
LINKCTRL_SECURE_COOKIES=false

# Comma-separated CIDRs. EMPTY means X-Forwarded-For is ignored entirely.
# Only set this when actually behind a proxy — a careless value lets clients
# spoof their IP, which defeats rate limiting and corrupts analytics.
LINKCTRL_TRUSTED_PROXIES=

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=linkctrl
POSTGRES_DB=linkctrl
POSTGRES_PORT=55432                   # dev override only; base compose publishes nothing
LINKCTRL_DATABASE_URL=postgres://linkctrl:CHANGEME@postgres:5432/linkctrl?sslmode=disable

# Two pools. The redirect pool is deliberately separate and small so a slow
# analytics query on the application pool cannot starve the hot path.
LINKCTRL_DB_MAX_CONNS=20
LINKCTRL_DB_MIN_CONNS=2
LINKCTRL_DB_REDIRECT_MAX_CONNS=6
LINKCTRL_DB_MAX_CONN_LIFETIME=1h
LINKCTRL_DB_MAX_CONN_IDLE_TIME=15m
LINKCTRL_DB_CONNECT_TIMEOUT=10s
LINKCTRL_MIGRATE_ON_START=true

# ─── Redis ───────────────────────────────────────────────────────────────────
# Cache only, no persistence. Redis being unavailable degrades performance but
# must never break redirects, so nothing correctness-critical is stored here.
LINKCTRL_REDIS_URL=redis://redis:6379/0
REDIS_PORT=56379                      # dev override only
REDIS_MAXMEMORY=256mb
LINKCTRL_REDIS_DIAL_TIMEOUT=1s
LINKCTRL_REDIS_READ_TIMEOUT=50ms      # hot path: fail fast to Postgres
LINKCTRL_REDIS_INVALIDATE_BUDGET=250ms # total an edit waits on the cache
LINKCTRL_REDIS_SUBSCRIBER_READ_TIMEOUT=30s # silence before the subscriber checks
LINKCTRL_REDIS_POOL_SIZE=50
LINKCTRL_CACHE_ENABLED=true

# ─── Redirect ────────────────────────────────────────────────────────────────
LINKCTRL_REDIRECT_TTL=24h
# Capped at 5m by validation: longer makes a newly created link look broken to
# anyone who probed the alias before it existed.
LINKCTRL_REDIRECT_NEGATIVE_TTL=60s
# Bounds every database call the redirect path makes: the Postgres fallback for
# an uncached alias, and each gate query — password verification, the signing-key
# read, the click-budget write and a sequential split's rotation. A query still
# running after this has already missed the target and is holding a connection
# while requests queue behind it.
LINKCTRL_REDIRECT_TIMEOUT=250ms
# 302 or 307 only. 301/308 are permanent, get cached by browsers and
# intermediaries, and would make later edits to a link ineffective forever.
LINKCTRL_REDIRECT_DEFAULT_STATUS=302
LINKCTRL_REDIRECT_LOG_SAMPLE=0        # 0 = off, N = log 1 in N successful redirects
LINKCTRL_REDIRECT_404_RATE_LIMIT=60   # per IP per minute, misses only
# Guesses at a password-protected link, per minute — counted per address AND per
# alias, because guesses driven through many visitors' browsers spread across
# addresses and would slip under a per-address limit entirely. Shared across
# replicas through Redis when there is one; without Redis it falls back to
# per-instance buckets, which makes it best-effort rather than a guarantee.
# 0 disables it.
LINKCTRL_LINK_PASSWORD_RATE_LIMIT=20

# ─── Custom domains ──────────────────────────────────────────────────────────
# A workspace's own hostname is served only while a DNS TXT record proves it
# controls the name. These two numbers decide when somebody's links go dark, and
# they are here rather than in the source because the trade is yours: the window
# is how long this instance keeps serving a hostname whose DNS its owner may no
# longer control, and the cadence is how much evidence there is before it
# expires. At the defaults a hostname must fail twenty-four consecutive checks.
# The runbook is in docs/deployment.md.
LINKCTRL_DOMAIN_VERIFY_INTERVAL=1h    # 0 switches re-verification off entirely
LINKCTRL_DOMAIN_VERIFY_GRACE=24h      # a failing hostname keeps serving this long
LINKCTRL_DOMAIN_VERIFY_DNS_TIMEOUT=5s # bounds one TXT lookup
LINKCTRL_DOMAIN_VERIFY_BATCH=500      # hostnames per pass, least recently checked first

# ─── Aliases and destinations ────────────────────────────────────────────────
LINKCTRL_ALIAS_LENGTH=7
LINKCTRL_ALIAS_MIN_USER_LENGTH=3
LINKCTRL_ALIAS_RESERVED_EXTRA=        # comma-separated, added to the built-in list
LINKCTRL_ALIAS_PROFANITY_FILTER=true
# SCHEMES may only narrow the built-in pair. Naming anything else is refused at
# startup: non-http(s) schemes are refused unappealably and this is not a way
# around that. Set it to `https` alone for TLS-only destinations.
LINKCTRL_DESTINATION_SCHEMES=http,https
LINKCTRL_DESTINATION_MAX_LENGTH=2048
# Comma-separated hosts, matched on a label boundary: evil.example also refuses
# login.evil.example and does not refuse notevil.example. These seed the runtime
# blocklist table at every boot and are reconciled against it — remove one here
# and it is retired on the next restart. What the instance owner blocked through
# review is never touched by this.
LINKCTRL_DESTINATION_BLOCKLIST=
#
# LINKCTRL_DESTINATION_BLOCK_PRIVATE_IPS was removed. Private, loopback,
# link-local, carrier-NAT and cloud-metadata addresses are refused
# unconditionally: the refusal protects the visitor whose browser would do the
# fetching, and they were not the party turning it off. To point links at an
# intranet, use a hostname that resolves there.

# ─── Reputation feeds (opt-in, off by default) ───────────────────────────────
# READ THIS BEFORE SETTING FEED_URL. It is the only setting in this file that
# sends your users' data to somebody else.
#
# Every other check this instance makes about a destination is local: a host
# list compiled into the binary, the blocklist table above, and rules that read
# the URL's own text. A reputation feed cannot work that way. Answering "is this
# destination malicious" means SENDING THE DESTINATION to a third party's
# server — every time a link is created or edited, the link domain's root
# redirect is set, or a refusal is disputed.
#
# That is a deliberate exception to this product's promise that no destination
# leaves the box uninvited, which is why it is off by default and why switching
# it on costs you a named feed rather than a boolean. The instance discloses it
# at /feeds, to every signed-in user, whether it is on or off. Nothing in the
# dashboard and no API call can change it — this file is the only switch.
#
# What a feed can and cannot do:
#   * It is asked LAST, and only about destinations every built-in check already
#     accepted. The protection you have with this empty is the protection you
#     keep when a feed is on.
#   * A refusal it produces is low-confidence: disputable, and the instance
#     owner can overrule it from the review queue. Overruling also stops that
#     host being sent again.
#   * If it times out, errors, or answers something this adapter cannot read,
#     the destination is ACCEPTED and linkctrl_destination_feed_checks_total
#     counts the failure. A third party's outage must not stop you making links.
#
# One generic HTTP adapter, not a list of integrations. Point it at any endpoint
# that takes a URL and answers JSON.
#
# DO NOT PUT THE CREDENTIAL IN THIS URL. https://key:secret@feed.example/ is
# refused at boot: Go sends it as Basic auth so it would work, and /feeds shows
# every signed-in user this endpoint. Use FEED_AUTH_TOKEN below, which is
# redacted, unset from the environment once read, and can come from a file.
# /feeds prints the scheme, host and path — a query string never, a key in the
# PATH always, and nothing can detect that one for you.
LINKCTRL_FEED_URL=                     # empty = off, and off is the default
# Who the destinations go to, in words. Required once URL is set, and it is what
# /feeds and the docs print. An instance may not send destinations somewhere it
# cannot name.
LINKCTRL_FEED_NAME=
LINKCTRL_FEED_METHOD=POST              # POST | GET
# The field carrying the destination: a JSON key on POST, a query parameter on
# GET.
LINKCTRL_FEED_PARAM=url
# Dotted path into the JSON response holding the verdict, e.g. data.malicious.
# True, a non-zero number, or one of yes/malicious/blocked/phishing/malware
# means refuse. Anything the adapter cannot read is counted as an error and
# fails open.
LINKCTRL_FEED_VERDICT_FIELD=blocked
# Sent only when the token is set. LINKCTRL_FEED_AUTH_TOKEN_FILE works too, for
# mounted secrets.
LINKCTRL_FEED_AUTH_HEADER=Authorization
LINKCTRL_FEED_AUTH_TOKEN=
# Bounds one check. Spent inside a form submission somebody is waiting on, so
# keep it small; validation refuses anything above HTTP_REQUEST_TIMEOUT.
LINKCTRL_FEED_TIMEOUT=2s

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Outbound delivery of workspace events (M42). There is no switch here: webhooks
# are registered by workspaces rather than enabled by you, and these two numbers
# apply the moment somebody registers one.
#
# What is NOT configurable is the attempt count — seven, spanning 61 minutes —
# because changing it changes what a receiver experiences rather than what this
# instance costs. It is documented in docs/usage.md.
#
# Every webhook URL is refused if it names a private, loopback or link-local
# address, and the address it actually resolves to is checked again at the moment
# the connection is opened. See docs/SECURITY.md for what that does and does not
# cover on a deployment with an egress proxy.
LINKCTRL_WEBHOOK_TIMEOUT=10s        # bounds one delivery attempt; must be <= 1m
LINKCTRL_WEBHOOK_RETENTION_DAYS=30  # how long a finished delivery row is kept; no "forever"

# ─── Update check ────────────────────────────────────────────────────────────
# Once a day this instance asks GitHub whether a newer LinkCtrl has been
# released, and puts a notification in the instance principal's inbox if there
# is one. It is the only scheduled work in this product that opens a socket to a
# host outside your deployment.
#
# What the request carries, in full: this server's source address, and the
# version it is running, in the User-Agent. Nothing else — no instance
# identifier, no deployment size, no link counts, no configuration, nothing
# about the people using it. There is no request body, no query string and no
# credential. The response is read for a version and discarded.
#
# Nothing leaves the instance until somebody here has been asked and said yes:
# on the setup page for a fresh instance, on the dashboard at the first
# administrative sign-in for one that was upgraded. Unanswered is off, so an
# instance nobody signs into never checks at all.
#
# This variable is the deployment's half of the switch and it only ever says no:
# false here means the instance never asks, whatever was answered in the
# browser, and true is permission rather than instruction. Air-gapped and
# egress-restricted deployments want false — with it left on and the question
# answered yes, the check simply fails and logs at debug, but the attempt is a
# connection your network policy will see.
LINKCTRL_UPDATE_CHECK=true          # daily release check; false disables it outright

# ─── Authentication ──────────────────────────────────────────────────────────
# SIGNUP_MODE is the mode, and this is the only place it is set. Nothing in the
# dashboard or the API changes it: admitting accounts to an instance is the
# operator's, so changing it is an edit here and a restart.
#
# closed admits no new account by any path, invitations included: an invite can
# only add somebody who already has one. invite and open both let an invitation
# create the account it names. open additionally opens the public /signup form
# and POST /api/v1/auth/register.
#
# open needs a mailer. Public registration confirms the address by email before
# the account is created, so with no SMTP_HOST the effective mode is `invite`
# whatever this says, and the server logs that at boot.
LINKCTRL_SIGNUP_MODE=closed           # closed | invite | open
LINKCTRL_SESSION_ABSOLUTE_TTL=720h    # 30 days
LINKCTRL_SESSION_IDLE_TTL=168h        # 7 days

# How long an invitation stays redeemable. The clock starts when it is created,
# not when the mail goes out — delivery is asynchronous — so a slow relay spends
# this window. There is no way to switch expiry off; revoking is how an
# invitation ends early.
LINKCTRL_INVITE_TTL=168h              # 7 days

# RFC 9106 floor is 19456 KiB; validation refuses anything lower.
LINKCTRL_ARGON2_MEMORY_KIB=65536
LINKCTRL_ARGON2_ITERATIONS=3
LINKCTRL_ARGON2_PARALLELISM=2

# Rate limits are per client address, per instance, and 0 disables one. Behind a
# reverse proxy set LINKCTRL_TRUSTED_PROXIES as well, or every request appears to
# come from the proxy and all traffic shares a single bucket.
LINKCTRL_LOGIN_RATE_PER_MIN=10         # credential endpoints; per address
LINKCTRL_LOGIN_LOCKOUT_THRESHOLD=5     # failures against one account
LINKCTRL_API_RATE_PER_MIN=600          # everything under /api/v1; dashboard pages are exempt
# The upload endpoints have a bucket of their own, and it applies on top of the
# API limit rather than instead of it. Two things carry a file: a QR code's logo,
# up to a megabyte and handed to an image decoder, and an add-on, up to 32 MiB and
# compiled. Either way what a request costs is set by its content — which is not
# what the number above was chosen about. One bucket for both, so an install and a
# logo upload from the same address spend the same budget.
LINKCTRL_UPLOAD_RATE_PER_MIN=30        # QR logo and add-on uploads; per address

# ─── Analytics ───────────────────────────────────────────────────────────────
# Click recording is asynchronous and never delays a redirect. A full queue
# drops events and counts them rather than applying backpressure.
LINKCTRL_INGEST_QUEUE_SIZE=16384
LINKCTRL_INGEST_BATCH_SIZE=500
LINKCTRL_INGEST_FLUSH_INTERVAL=250ms

# Enforced by dropping whole monthly partitions, so data survives up to a month
# past the window. 0 = keep forever.
LINKCTRL_ANALYTICS_RETENTION_DAYS=395 # 13 months

# The audit log keeps its own window, and its default is the opposite one:
# nothing is ever deleted until you set a number here. An upgrade that silently
# started expiring history an operator assumed permanent is the worse failure,
# so growth is made visible instead — linkctrl_audit_log_bytes, and the alert
# recipe in docs/operations.md.
LINKCTRL_AUDIT_RETENTION_DAYS=0 # keep forever

# Once the audit partitions pass this, owners get an in-app notification. On by
# default, unlike the retention window above, and deliberately so: keeping
# everything forever is only safe if the instance nobody configured is the one
# that gets warned. 0 disables it. 5 GiB.
LINKCTRL_AUDIT_SIZE_WARN_BYTES=5368709120

# Optional. The MaxMind database cannot be redistributed in the image; without it
# geographic reporting is disabled and the UI says so. Country only: region and
# city are resolvable and deliberately not stored.
# See docs/deployment.md.
LINKCTRL_GEOIP_MMDB_PATH=

# Removed variables. LINKCTRL_INGEST_WORKERS, LINKCTRL_BOT_FILTER_ENABLED and
# LINKCTRL_VISITOR_SALT_ROTATION used to appear here and no longer exist: one
# ingest consumer, always-on bot classification and daily salt rotation are the
# design rather than defaults. Startup warns if one is still set.

# ─── Mail ────────────────────────────────────────────────────────────────────
# Off unless you set a host. Leave it empty and the instance behaves exactly as
# it does without this section: notifications are delivered in the dashboard and
# nowhere else, and nothing is ever queued.
#
# Sends never happen on the request path. A message is written to the mail_outbox
# table and delivered by the scheduler, so mail queued before a restart is still
# delivered after it, and what was attempted stays readable in the table:
# recipient, subject, kind, attempts and the relay's last error. The body is not
# — it is erased when the message is sent or abandoned, because an invitation's
# body contains the invitation link.
#
# The supported surface is deliberately small: STARTTLS on submission, implicit
# TLS, or an unencrypted connection to a relay that needs no credentials; PLAIN
# authentication, over an encrypted connection only. LOGIN, CRAM-MD5, XOAUTH2 and
# client certificates are not supported. See docs/configuration.md.
LINKCTRL_SMTP_HOST=
LINKCTRL_SMTP_PORT=587
LINKCTRL_SMTP_TLS=starttls            # starttls | tls | none
# Required once a host is set. A bare address or a display-name form.
LINKCTRL_SMTP_FROM=
# Both or neither. LINKCTRL_SMTP_PASSWORD_FILE works too, for mounted secrets.
LINKCTRL_SMTP_USERNAME=
LINKCTRL_SMTP_PASSWORD=
# Bounds one delivery attempt end to end: dial, handshake, DATA.
LINKCTRL_SMTP_TIMEOUT=10s

# ─── Add-ons ─────────────────────────────────────────────────────────────────
# Off unless you set a directory, and off is the shipped default. Empty means no
# WASM runtime is constructed, no add-on is loaded, no metric series is published
# and nothing costs this instance anything.
#
# Set it to a directory holding one subdirectory per add-on, each containing an
# addon.json and the .wasm file that manifest describes. The host reads it at
# boot: it checks the ABI generation the manifest declares, verifies every module
# against the sha256 beside it, and either instantiates it or refuses it. A module
# whose bytes do not match is never compiled, and one built against an ABI this
# build does not serve is refused before its bytes are read at all.
#
# **A module in here is code this instance executes.** Who may write to this
# directory is the whole of the trust boundary — it is yours to own, not an
# add-on's and not a tenant's. In Docker, mount it read-only.
#
# Read-only is a choice with a consequence, and it is the safe one. The API can
# also install an add-on into this directory without a restart, under a
# permission only the account that administers the instance holds; with the
# directory mounted read-only that refuses with a 503 saying so, and the only
# writer stays whoever has filesystem access. Mount it writable and the server
# becomes a writer to the directory it executes from. Both are supported; see the
# add-on section of docs/configuration.md before you pick.
#
# What happens when an add-on will not load is the add-on's declaration, not
# yours: a manifest saying `required` stops the instance with the reason, one
# saying `degrade` logs, counts and lets the instance serve without it. So does a
# manifest this host cannot parse — there is no class to honour, and guessing the
# forgiving one would boot an instance with sign-in silently missing.
#
# A module that never returns from its initialization is a failure like any other:
# each add-on's module gets 30 seconds to compile and 30 seconds to start, and one
# that runs past that is refused as `load_timeout`, logged and counted, with the
# declared class deciding what it costs. The budget covers the add-on's own code
# and not this host's work with your database, so a slow migration is not this —
# see the add-on section of docs/configuration.md.
# See docs/configuration.md.
LINKCTRL_ADDONS_DIR=

# An add-on's own settings are read from this environment too, one variable per
# setting its manifest declares (M64):
#
#   LINKCTRL_ADDON_<NAME>_<SETTING>
#
# Both halves upper-cased — an add-on called `oidc` declaring a `client_id`
# setting reads LINKCTRL_ADDON_OIDC_CLIENT_ID. Only declared settings are read,
# so a variable for a setting no manifest names does nothing and is not a typo
# this file can catch for you; the add-on's own documentation is what lists them.
# A value set here outranks the default the manifest declared, and a setting that
# is a secret has no default at all, so it is a value or it is absent.
#
# There is no line to uncomment because the names depend on what you installed.
# Editing these from the dashboard is the Add-on manager's, which is not built
# yet; until then this file is the whole of it.
#
# Two names in that namespace are this product's own and no add-on may take
# them: an add-on called `inline` or `instantiate` is refused at load, because a
# setting of its called `deadline` would be read from one of the two variables
# below.

# How long an add-on that runs *inside* the redirect path may hold a redirect
# open before this host stops waiting for it, kills the invocation and answers
# the visitor without it (M66).
#
# It applies only to a module holding `redirect.inline`, which no add-on holds
# unless its manifest asked for it, so on an instance with no such add-on this
# value bounds nothing and costs nothing.
#
# **It is deliberately larger than the 20ms cached-redirect target**, and that is
# not a contradiction. The target is *core's*, measured with nothing on the path
# — see docs/slo.md, where the figure is stated as core with no inline add-on and
# a run with a deliberately slow module sits beside it. This is the point at
# which the host stops waiting for somebody else's code, and setting it under the
# target would kill add-ons that were working perfectly well.
#
# The default is measured rather than picked: a module answers in about 4ms on
# the machine the figure was taken on, so this is roughly six times the cost of a
# module that does its work and returns.
#
# **It bounds the module's own code and nothing else.** Starting the module is
# this host's cost on this host's machine, and it is bounded separately by the
# variable below. The two were one number until 2026-08-23, and on hardware
# slower than the machine the 25ms was measured on that meant every invocation
# was killed before the add-on's code ran — with the counter blaming the add-on.
#
# Raising it lets a slower add-on finish; it also lengthens how long a hung one
# holds a request. Lowering it does the reverse. Whichever way you move it,
# `linkctrl_addon_redirect_kills_total{step="call"}` is the number that tells you
# whether it is set where you meant.
LINKCTRL_ADDON_INLINE_DEADLINE=25ms

# How long this instance will spend *starting* an add-on's module for a redirect
# — inline or observing — before it gives up and serves the redirect without it.
#
# This one is not the add-on's budget, it is yours. Instantiating a module is
# work this host does on this machine, and what it costs depends on the hardware,
# on how busy the instance is and on nothing the add-on chose: measured here with
# all sixteen instance slots busy it is a mean of 9.6ms and a worst of 62.7ms,
# against about 1.6ms for a single instantiation on an idle machine. That range
# is why it is a separate number, and why it is wider than the deadline above.
#
# What it is really bounding is a module that hangs in package initialization —
# code that runs while the module is being started, before anything has called
# it. So it is the longest one visitor waits for one broken module.
#
# Raise it if `linkctrl_addon_redirect_kills_total{step="instantiate"}` is
# moving: that is this instance failing to start an add-on in time, not an add-on
# misbehaving, and the fix is a wider bound or a less busy machine. The `call`
# step on the same counter is the other party.
LINKCTRL_ADDON_INSTANTIATE_DEADLINE=500ms

# How many add-on instances this instance keeps ready, across every add-on, when
# nothing is using them.
#
# **This is not how many add-ons run at once.** That is sixteen, it is fixed in
# the build, and no variable here moves it. This is how many of the instances
# they run in are kept afterwards instead of being thrown away — a redirect that
# finds one waiting skips allocating the module's memory and running its startup
# code, which for a well-behaved add-on measured at 2,000 redirects a second was
# almost the whole of an 11.05ms invocation. Pooling took that invocation to 451µs
# and the visitor's p99 from 44.89ms to 1.08ms.
#
# The cost is memory held while nothing is using it: up to this many instances of
# 8 MiB, on top of the sixteen that may be in flight — and a host-side copy of
# each live instance's memory beside it, which is what an instance is reset to and
# is not inside the guest bound, so budget the number twice. Eight is measured —
# that rate wants about one instance at any moment, and eight covers the bursts
# around it. Raising it past what your traffic wants buys nothing. Zero means the
# default, not "no pool".
LINKCTRL_ADDON_POOL_SIZE=8

# How long an unused add-on instance is kept before it is closed.
#
# It keeps the memory above proportional to traffic rather than to the busiest
# minute since the process started. Under any load worth pooling for, an instance
# is taken again within milliseconds and this never fires; on a quiet instance it
# is what stops eight instances outliving the burst that made them.
LINKCTRL_ADDON_POOL_TTL=1m

# ─── Lifecycle ───────────────────────────────────────────────────────────────
# DRAIN_DELAY + TIMEOUT must stay comfortably under the compose
# stop_grace_period of 30s, or Docker sends SIGKILL mid-flush and the buffered
# click events that graceful shutdown exists to save are lost anyway.
LINKCTRL_SHUTDOWN_DRAIN_DELAY=5s
LINKCTRL_SHUTDOWN_TIMEOUT=15s
# A context deadline on the application tree: queries abort and the client gets a
# 504. The redirect tree is not covered by it — LINKCTRL_REDIRECT_TIMEOUT bounds
# that path instead, and 15s there would be meaningless.
LINKCTRL_HTTP_REQUEST_TIMEOUT=15s
LINKCTRL_HTTP_READ_HEADER_TIMEOUT=5s
LINKCTRL_HTTP_WRITE_TIMEOUT=30s

# ─── Compose ─────────────────────────────────────────────────────────────────
# Read by docker-compose.yml, not by the binary. The hostname the instance
# answers on is LINKCTRL_BASE_URL (or the APP/LINK pair above); there is no
# separate domain variable, and no Caddyfile in this repository — the reverse
# proxy is yours to configure, see docs/deployment.md.
LINKCTRL_TAG=latest
LINKCTRL_HTTP_PORT=8080

# Image repository, paired with the tag above. The default pulls releases from
# GHCR; a local name runs an image you built instead, which is what the two
# development instances do — see docs/dev-notes/instances.md.
#LINKCTRL_IMAGE=ghcr.io/devofpie/linkctrl

# Which file compose loads into the container. Leave it unset for this one.
# `docker compose --env-file other.env` redirects only the file compose
# interpolates variables from; without this, the container would still be handed
# .env, so a second instance would run on the first one's configuration.
#LINKCTRL_ENV_PATH=.env

# Restart policy for all three services. `unless-stopped` is what a deployment
# wants; `no` suits a development stack that is stopped when idle and should not
# come back on its own after a reboot.
#LINKCTRL_RESTART=unless-stopped

# Host port for the metrics listener, published on 127.0.0.1 by the *development*
# override only. The base file publishes nothing here on purpose: the endpoint is
# unauthenticated, and its series describe traffic shape and saturation.
#LINKCTRL_METRICS_PORT=9090
