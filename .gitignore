# Build output
/bin/
/dist/
/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage output
*.test
*.out
cover.out
coverage.html
/test/load/aliases.json

# Secrets and local configuration. Only .env.example is committed.
.env
.env.*
!.env.example

# Generated CSS. CI and the Docker build run `make css` before `go build`;
# see the css target in the Makefile.
/internal/ui/static/css/app.css

# Tailwind standalone CLI, downloaded on demand by `make tailwind`.
/bin/tailwindcss*

# Optional GeoIP database — cannot be redistributed, see docs/deployment.md.
*.mmdb
# Except the test fixture, which is synthetic: built by testdata/gen_mmdb.go from
# documentation ranges and invented countries, and nothing MaxMind published. The
# geoip tests need it, so it has to be in the tree.
!internal/geoip/testdata/*.mmdb

# npm is only ever a fallback for the Tailwind build; it is never used in the
# production image.
node_modules/

# Working state for the milestone in flight, per docs/build-notes/phase-loop.md.
# Deliberately untracked: `git status --porcelain` skips ignored files, so it
# cannot dirty the tree that `make demo-update` and `make release-check` refuse
# to run on. It holds nothing that outlives the milestone.
.current-task.md

# Editor and OS noise
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db